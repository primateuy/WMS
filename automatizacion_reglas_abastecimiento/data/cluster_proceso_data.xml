<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_cluster_proceso" model="ir.sequence">
      <field name="name">Actualización por Cluster</field>
      <field name="code">cluster.proceso</field>
      <field name="prefix">CLU/</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
  <data>
    <!-- Sólo avanza lo que ya está en cola: una tanda por ejecución, disparado
         con _trigger() al encolar. El intervalo es el piso por si el disparo se
         pierde. numbercall=-1: con el default (1) Odoo lo apaga tras la primera
         corrida. -->
    <record id="ir_cron_cluster_proceso" model="ir.cron">
      <field name="name">Cluster: actualización de rutas y reglas en segundo plano</field>
      <field name="model_id" ref="model_cluster_proceso"/>
      <field name="state">code</field>
      <field name="code">model._cron_procesar()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <field name="numbercall">-1</field>
      <field name="doall" eval="False"/>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
