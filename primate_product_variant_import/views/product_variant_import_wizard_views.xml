<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="primate_product_variant_import_wizard_form" model="ir.ui.view">
        <field name="name">primate.product.variant.import.wizard.form</field>
        <field name="model">product.variant.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Variantes desde Excel">

                <!-- PASO 1 -->
                <div invisible="state == 'done'">
                    <div class="alert alert-info mb-3" role="alert">
                        <div class="row">
                            <div class="col-12">
                                <strong>Formato requerido del Excel</strong>
                                — cada fila representa una variante.
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td><code>Referencia Interna</code></td>
                                            <td>Ref. interna de la variante (opcional)</td></tr>
                                        <tr><td><code>Product Template</code></td>
                                            <td>ID externo o nombre exacto del template</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td><code>Atributo 1</code> / <code>Valor Atributo 1</code></td>
                                            <td>Primer par atributo-valor</td></tr>
                                        <tr><td><code>Atributo N</code> / <code>Valor Atributo N</code></td>
                                            <td>Tantos pares como se necesiten</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row mt-1">
                            <div class="col-12 text-muted" style="font-size:0.875rem">
                                Funciona con templates configurados como
                                "No crearlas automáticamente". Cada fila puede
                                referenciar un template distinto.
                            </div>
                        </div>
                    </div>
                    <group>
                        <group string="Archivo">
                            <field name="import_file" filename="import_file_name" widget="binary"/>
                            <field name="import_file_name" invisible="1"/>
                        </group>
                    </group>
                </div>

                <!-- PASO 2: resultado -->
                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        <h5 class="alert-heading">
                            <i class="fa fa-check-circle"/> Importación completada
                        </h5>
                        <p>El resultado quedó registrado en el historial.</p>
                    </div>
                    <group>
                        <field name="job_id" readonly="1"/>
                    </group>
                </div>

                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_import" string="Importar" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_download_template" string="Descargar Plantilla"
                            type="object" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_view_job" string="Ver resultado" type="object"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_primate_product_variant_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Variantes desde Excel</field>
        <field name="res_model">product.variant.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="primate_product_variant_import_wizard_form"/>
    </record>
</odoo>
