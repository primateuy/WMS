<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista -->
    <record id="primate_variant_import_job_list" model="ir.ui.view">
        <field name="name">primate.variant.import.job.list</field>
        <field name="model">primate.variant.import.job</field>
        <field name="arch" type="xml">
            <list string="Historial de Importaciones" decoration-success="state == 'done'"
                  decoration-danger="state == 'error'" decoration-warning="state == 'running'"
                  decoration-muted="state == 'pending'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="import_file_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'running'"
                       decoration-info="state == 'pending'"/>
                <field name="line_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <!-- Vista form -->
    <record id="primate_variant_import_job_form" model="ir.ui.view">
        <field name="name">primate.variant.import.job.form</field>
        <field name="model">primate.variant.import.job</field>
        <field name="arch" type="xml">
            <form string="Importación de Variantes">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Información">
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="import_file_name" readonly="1"/>
                        </group>
                        <group string="Resultado" invisible="state == 'pending'">
                            <field name="line_count" readonly="1"/>
                            <field name="created_count" readonly="1"/>
                            <field name="updated_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Detalle" invisible="state in ('pending', 'running')">
                        <field name="result_info" widget="text" readonly="1"
                               nolabel="1"
                               style="font-family: monospace; font-size: 0.875rem;
                                      white-space: pre-wrap; min-height: 200px;
                                      background: #f8f9fa; padding: 12px;
                                      border-radius: 4px; border: 1px solid #dee2e6;
                                      display: block; width: 100%;"/>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'running'">
                        <i class="fa fa-spinner fa-spin"/> Procesando... actualizá la página para ver el resultado.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'pending'">
                        <i class="fa fa-clock-o"/> En cola, esperando el próximo ciclo del scheduler.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción lista -->
    <record id="action_primate_variant_import_job" model="ir.actions.act_window">
        <field name="name">Historial de Importaciones</field>
        <field name="res_model">primate.variant.import.job</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- Menú historial en Inventario > Productos -->
    <menuitem id="menu_primate_variant_import_job"
              name="Historial de Importaciones"
              parent="stock.menu_stock_inventory_control"
              action="action_primate_variant_import_job"
              sequence="100"
              groups="base.group_user"/>
</odoo>
