<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_create_reordering_primate" model="ir.ui.view">
        <field name="name">create.reordering.wizard.primate</field>
        <field name="model">create.reordering</field>
        <field name="inherit_id" ref="setu_advance_reordering.form_create_reordering"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_ids']" position="before">
                <field name="product_category_ids" widget="many2many_tags"
                       options="{'no_create': 1, 'no_create_edit': 1}"/>
                <field name="warehouse_group_ids" widget="many2many_tags"
                       options="{'no_create': 1, 'no_create_edit': 1}"/>
                <button name="action_load_products_by_category_and_group" type="object"
                        string="Cargar por categoría y grupo"
                        class="btn-secondary" icon="fa-plus"
                        invisible="not product_category_ids and not warehouse_group_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
