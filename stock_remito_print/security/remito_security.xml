<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Categoría propia: sin ella el grupo solo se ve en modo desarrollador. -->
    <record id="module_category_remito_remitos" model="ir.module.category">
        <field name="name">Remitos</field>
        <field name="description">Impresión de remitos de inventario</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_remito_print_only" model="res.groups">
        <field name="name">Impresión de remitos (solo)</field>
        <field name="category_id" ref="module_category_remito_remitos"/>
        <!--
            Hereda base.group_user para poder entrar al backend, pero NO
            stock.group_stock_user: este perfil no tiene que ver la app
            Inventario ni ningún otro menú del ERP.
        -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Perfil para operadores logísticos: solo puede
            listar operaciones de inventario e imprimir sus remitos. Exige
            tener restringidos los tipos de operación.</field>
    </record>

    <!--
        Reglas de registro globales (sin grupos): aplican a todos los
        usuarios, pero solo recortan algo cuando el usuario tiene activada
        la restricción. Con restrict_picking_types en False el dominio queda
        vacío y no filtra nada.

        El dominio se evalúa con safe_eval y `user` llega en sudo
        (Environment.user), así que leer los campos propios no choca con
        las ACL.
    -->
    <record id="rule_stock_picking_allowed_types" model="ir.rule">
        <field name="name">Operaciones: tipos de operación permitidos por usuario</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[('picking_type_id', 'in', user.allowed_picking_type_ids.ids)] if user.restrict_picking_types else []</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_stock_picking_type_allowed_types" model="ir.rule">
        <field name="name">Tipos de operación: permitidos por usuario</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">[('id', 'in', user.allowed_picking_type_ids.ids)] if user.restrict_picking_types else []</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        En movimientos la regla es solo de lectura y deja pasar los que no
        tienen operación asociada: valorización, producción y ajustes de
        inventario trabajan con movimientos sin picking y no hay que
        cortarlos.
    -->
    <record id="rule_stock_move_allowed_types" model="ir.rule">
        <field name="name">Movimientos: tipos de operación permitidos por usuario</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="domain_force">['|', ('picking_id', '=', False), ('picking_id.picking_type_id', 'in', user.allowed_picking_type_ids.ids)] if user.restrict_picking_types else []</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_stock_move_line_allowed_types" model="ir.rule">
        <field name="name">Detalle de movimientos: tipos de operación permitidos por usuario</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="domain_force">['|', ('picking_id', '=', False), ('picking_id.picking_type_id', 'in', user.allowed_picking_type_ids.ids)] if user.restrict_picking_types else []</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
