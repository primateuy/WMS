<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_server_remito_mark_printed" model="ir.actions.server">
        <field name="name">Marcar como impresa</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user')), (4, ref('stock_remito_print.group_remito_print_only'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_remito_mark_printed()</field>
    </record>

    <record id="action_server_remito_mark_unprinted" model="ir.actions.server">
        <field name="name">Marcar como no impresa</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_user')), (4, ref('stock_remito_print.group_remito_print_only'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_remito_mark_unprinted()</field>
    </record>

</odoo>
