<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Banner de advertencia en el formulario del picking -->
        <record id="view_picking_form_multiplos_banner" model="ir.ui.view">
            <field name="name">stock.picking.form.multiplos.banner</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="before">
                    <field name="tiene_multiplos_incumplidos" invisible="1"/>
                    <div class="alert alert-warning mb-0"
                         role="alert"
                         invisible="not tiene_multiplos_incumplidos">
                        <i class="fa fa-exclamation-triangle"/> <strong>Atención:</strong>
                        Una o más líneas no respetan el múltiplo de distribución.
                        Revisá las cantidades antes de validar.
                    </div>
                </xpath>

                <!-- Colorear en amarillo las filas de moves con multiplo incumplido -->
                <xpath expr="//field[@name='move_ids_without_package']/list" position="attributes">
                    <attribute name="decoration-warning">multiplo_incumplido</attribute>
                </xpath>

                <!-- Campo oculto necesario para que decoration-warning funcione -->
                <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="before">
                    <field name="multiplo_incumplido" column_invisible="1"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
