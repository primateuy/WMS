<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Banner de advertencia en el formulario del picking -->
        <record id="view_picking_form_multiplos_banner" model="ir.ui.view">
            <field name="name">stock.picking.form.multiplos.banner</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="not tiene_multiplos_incumplidos">
                        <span class="fa fa-exclamation-triangle mr-1"/>
                        <strong>Atención:</strong>
                        Una o más líneas no respetan el múltiplo de distribución del producto.
                        Revisá las cantidades antes de validar
                        (las líneas con problema están marcadas con
                        <span class="fa fa-exclamation-circle text-warning"/>).
                    </div>
                </xpath>

                <!-- Columna de warning en la lista de moves -->
                <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="before">
                    <field name="multiplo_incumplido" column_invisible="1"/>
                    <widget name="boolean_favorite"
                            nolabel="1"
                            invisible="not multiplo_incumplido"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
