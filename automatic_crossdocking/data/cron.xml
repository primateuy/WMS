<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Arma en segundo plano los pickings de las OC de crossdock confirmadas.
             Se dispara al confirmar (_trigger); el intervalo es sólo la red de seguridad. -->
        <record id="ir_cron_armar_crossdock" model="ir.cron">
            <field name="name">Crossdock: armado de pickings</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_armar_crossdock()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>


    </data>
</odoo>
