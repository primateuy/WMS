<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Recalcula por tandas la cantidad a pedir que las operaciones grandes difirieron.
             Se dispara al encolar (_trigger); el intervalo es sólo la red de seguridad. -->
        <record id="ir_cron_reorden_recalculo" model="ir.cron">
            <field name="name">Reabastecimiento: recálculo diferido de la cantidad a pedir</field>
            <field name="model_id" ref="model_reorden_recalculo_pendiente"/>
            <field name="state">code</field>
            <field name="code">model._cron_recalcular()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
