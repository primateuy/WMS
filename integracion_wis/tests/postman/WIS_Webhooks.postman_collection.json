            "name": "00 - Ping (test handler, seguro)",
            "request": {
                "method": "POST",
                "header": [
                    {"key": "Content-Type", "value": "application/json"}
                ],
                "url": {"raw": "{{base_url}}/webhook/wis/callback", "host": ["{{base_url}}"], "path": ["webhook", "wis", "callback"]},
                "body": {"mode": "raw", "raw": "{\n    \"Id\": \"test\",\n    \"NumeroInterfazEjecucion\": 1,\n    \"Test\": {}\n}"}
            }
        },
