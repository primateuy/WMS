<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_picking_form_inherit_wms" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.wms</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <!-- Priority alto para que el xpath del botón create_delivery_guide
                 se aplique DESPUÉS de l10n_uy_einvoice_base.stock.picking.edi.form. -->
            <field name="priority">100</field>
            <field name="arch" type="xml">

                <!-- IDs WMS junto al origen -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="idPedidoWMS" readonly="1"/>
                    <field name="codigo_unico" readonly="1"/>
                    <field name="wms_referencia" readonly="1"/>
                    <field name="wis_location_id" readonly="1"/>
                    <field name="wis_panel_id" readonly="1"/>
                </xpath>

                <!-- Badge de estado WMS en el header, solo si fue enviado -->
                <xpath expr="//header" position="inside">
                    <field name="wms_estado" widget="statusbar"
                           statusbar_visible="sin_enviar,enviado,preparado,despachado,anulado,en_proceso_cancelacion,error_cancelacion"/>
                    <field name="wms_origen" widget="badge"
                           invisible="wms_origen == 'manual'"/>
                    <!-- Reenvío manual de LPN (caja cerrada): recupera el caso referencia OK / LPN falló -->
                    <field name="wis_enviar_lpns" invisible="1"/>
                    <button name="action_wis_reenviar_lpns" type="object"
                            string="Reenviar LPN a WIS"
                            invisible="not wis_enviar_lpns"
                            groups="stock.group_stock_user"/>
                </xpath>

                <!-- Spec 1: ocultar Cancelar cuando hay una cancelación pendiente de resolver
                     con WIS (wms_estado='en_proceso_cancelacion'), sumándolo a la condición core. -->
                <xpath expr="//header//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state not in ('assigned', 'confirmed', 'draft', 'waiting') or wms_estado == 'en_proceso_cancelacion'</attribute>
                </xpath>

                <!-- Pestaña WMS + Logs -->
                <xpath expr="//notebook" position="inside">

                    <!-- Pestaña integración WMS -->
                    <page string="Integración WMS" name="integracion_wms"
                          >

                        <group string="Estado general">
                            <group>
                                <field name="wms_estado"/>
                                <field name="wms_origen"/>
                                <field name="wms_fecha_confirmacion" readonly="1"/>
                            </group>
                            <group>
                                <field name="wms_referencia" readonly="1"/>
                                <field name="idPedidoWMS" readonly="1"/>
                                <field name="codigo_unico" readonly="1"/>
                                <field name="wis_location_id" readonly="1"/>
                                <field name="wis_panel_id" readonly="1"/>
                            </group>
                        </group>

                        <group string="Configuración de envío">
                            <group>
                                <field name="wms_nro_caja"
                                       help="Solo para pedidos FINT. Si se completa, el WMS preparará esa caja específica (LPN tipo FINTEMP)."/>
                                <field name="wms_lpns_enviados" readonly="1"
                                       invisible="not wis_enviar_lpns"/>
                            </group>
                        </group>

                        <group string="Preparación"
                               >
                            <group>
                                <field name="wms_fecha_preparacion" readonly="1"/>
                                <field name="wms_cantidad_bultos" readonly="1"/>
                                <field name="wms_peso_total" readonly="1"/>
                            </group>
                            <group>
                                <field name="wms_transportadora" readonly="1"/>
                                <field name="wms_observaciones_preparacion" 
                                       readonly="1" colspan="2"/>
                            </group>
                        </group>

                        <group string="Despacho">
                            <group>
                                <field name="wms_fecha_despacho" readonly="1"/>
                                <field name="wms_nro_remito" readonly="1"/>
                                <field name="wms_nro_seguimiento" readonly="1"/>
                                <field name="wms_descripcion_camion" readonly="1"/>
                            </group>
                            <group>
                                <field name="wms_cantidad_bultos" readonly="1"/>
                                <field name="wms_peso_total" readonly="1"/>
                            </group>
                        </group>

                        <group string="Anulación">
                            <group>
                                <field name="wms_fecha_anulacion" readonly="1"/>
                                <field name="wms_motivo_anulacion" readonly="1"/>
                            </group>
                            <group>
                                <field name="wms_nro_preparacion" readonly="1"/>
                            </group>
                        </group>

                    </page>

                    <!-- Pestaña logs -->
                    <page string="Logs WMS" name="logs_wms">
                        <field name="log_ids" readonly="1">
                            <tree decoration-danger="nivel == 'error'"
                                  decoration-warning="nivel == 'warning'"
                                  decoration-success="nivel == 'info' and resultado == 'exito'"
                                  create="0" delete="0" edit="0">
                                <field name="fecha"/>
                                <field name="nivel"/>
                                <field name="resultado"/>
                                <field name="texto"/>
                                <field name="detalle"/>
                                <field name="payload_webhook" string="Webhook recibido" optional="show"/>
                            </tree>
                            <form create="0" delete="0" edit="0">
                                <group>
                                    <group>
                                        <field name="fecha" readonly="1"/>
                                        <field name="nivel" readonly="1"/>
                                        <field name="resultado" readonly="1"/>
                                        <field name="modelo" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="texto" widget="text" readonly="1"/>
                                        <field name="detalle" widget="text" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Payload recibido de WIS" invisible="not payload_webhook">
                                    <field name="payload_webhook" widget="text" readonly="1" nolabel="1"/>
                                </group>
                            </form>
                        </field>
                    </page>

                </xpath>

                <!-- Punto 3: ocultar el botón "e-Remito" cuando la location destino
                     tenga el flag activo. wis_skip_eremito está expuesto invisible
                     para que la expresión del invisible del botón pueda evaluarse. -->
                <xpath expr="//field[@name='origin']" position="before">
                    <field name="wis_skip_eremito" invisible="1"/>
                </xpath>
                <xpath expr="//header//button[@name='create_delivery_guide']" position="attributes">
                    <attribute name="invisible">state != 'done' or company_country_code != 'UY' or not uses_cfe or cfe_emitido or wis_skip_eremito</attribute>
                </xpath>

            </field>
        </record>

        <!-- Filtros WMS en la vista lista -->
        <record id="view_picking_list_wms_filter" model="ir.ui.view">
            <field name="name">stock.picking.list.wms.filter</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_internal_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='available']" position="after">
                    <separator/>
                    <filter string="Preparados por WMS"
                            name="wms_preparado"
                            domain="[('wms_estado', '=', 'preparado')]"/>
                    <filter string="Despachados por WMS"
                            name="wms_despachado"
                            domain="[('wms_estado', '=', 'despachado')]"/>
                    <filter string="Anulados por WMS"
                            name="wms_anulado"
                            domain="[('wms_estado', '=', 'anulado')]"/>
                    <separator/>
                    <filter string="Origen: Ajuste WMS"
                            name="wms_origen_ajuste"
                            domain="[('wms_origen', '=', 'ajuste')]"/>
                    <filter string="Origen: Almacenamiento WMS"
                            name="wms_origen_almacenamiento"
                            domain="[('wms_origen', '=', 'almacenamiento')]"/>
                    <filter string="Origen: Recepción WMS"
                            name="wms_origen_recepcion"
                            domain="[('wms_origen', '=', 'recepcion')]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>