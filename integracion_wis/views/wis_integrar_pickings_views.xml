<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard de integración manual masiva con WMS -->
    <record id="view_wis_integrar_pickings_wizard_form" model="ir.ui.view">
        <field name="name">wis.integrar.pickings.wizard.form</field>
        <field name="model">wis.integrar.pickings.wizard</field>
        <field name="arch" type="xml">
            <form string="Integrar con WMS">
                <field name="total" invisible="1"/>
                <field name="integrables" invisible="1"/>
                <field name="picking_ids" invisible="1"/>
                <field name="mensaje" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_confirmar" type="object" string="Integrar"
                            class="btn-primary" invisible="integrables == 0"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción masiva "Integrar con WMS" en el listado de operaciones (menú Acciones) -->
    <record id="action_integrar_pickings_wms" model="ir.actions.server">
        <field name="name">Integrar con WMS</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Integrar con WMS',
    'res_model': 'wis.integrar.pickings.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': dict(env.context, active_ids=env.context.get('active_ids') or []),
}
        </field>
    </record>
</odoo>
