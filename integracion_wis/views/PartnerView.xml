<odoo>
    <data>
        <record id="view_res_partner_form_inherit_wis" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.wis</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Integración WIS" name="wis_integration">
                        <group>
                            <field name="integracion_wms"/>
                            <field name="codigo_wms" readonly="True"/>
                            <field name="codigo_unico" readonly="True"/>
                        </group>
                        <button name="enviarWS" 
                            string="Enviar a WIS" 
                            type="object" 
                            class="btn-primary"/>

                        <separator string="Historial de Operaciones WMS"/>
                            <field name="logs" readonly="1">
                                <tree
                                      create="0" delete="0" edit="0">
                                    <field name="fecha"/>
                                    <field name="texto"/>
                                </tree>
                                <form create="0" delete="0" edit="0">
                                    <group>
                                        <group>
                                            <field name="fecha" readonly="1"/>
                                            <field name="texto" readonly="1"/>
                                        </group>
                                    </group>
                                    
                                </form>
                            </field>
                    
                    </page>

                   
                </xpath>


              
            </field>
        </record>
    </data>
</odoo>