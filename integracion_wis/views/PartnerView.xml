<odoo>
    <data>
        <record id="view_res_partner_form_inherit_wis" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.wis</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Pestaña Integración WIS: configuración y botones -->
                <xpath expr="//notebook" position="inside">
                    <page string="Integración WIS" name="wis_integration">
                        <group>
                            <field name="integracion_wms"/>
                            <field name="codigo_wms" readonly="True" invisible="not integracion_wms"/>
                        </group>
                        <field name="customer_rank" invisible="True"/>
                        <field name="supplier_rank" invisible="True"/>
                        <group string="Identificaciones WIS" invisible="not integracion_wms">
                            <field name="codigo_unico_cliente" readonly="True"
                                invisible="customer_rank == 0"/>
                            <field name="codigo_unico_proveedor" readonly="True"
                                invisible="supplier_rank == 0"/>
                        </group>
                        <button name="enviarWS"
                            string="Enviar a WIS"
                            type="object"
                            class="btn-primary"
                            invisible="not integracion_wms or codigo_unico_cliente or codigo_unico_proveedor"/>
                        <button name="enviarWS"
                            string="Sincronizar desde WIS"
                            type="object"
                            class="btn-primary"
                            invisible="not integracion_wms or (not codigo_unico_cliente and not codigo_unico_proveedor)"/>
                    </page>

                    <!-- Pestaña Logs WIS al mismo nivel que Integración WIS -->
                    <page string="Logs WIS" name="wis_logs_page" invisible="not integracion_wms">
                        <field name="logs" readonly="1">
                            <tree decoration-success="resultado == 'exito'"
                                  decoration-danger="resultado == 'error'"
                                  create="0" delete="0" edit="0">
                                <field name="fecha"/>
                                <field name="operacion"/>
                                <field name="resultado"/>
                                <field name="texto"/>
                                <field name="payload_enviado" string="Enviado a WIS" optional="show"/>
                            </tree>
                            <form create="0" delete="0" edit="0">
                                <group>
                                    <group>
                                        <field name="fecha" readonly="1"/>
                                        <field name="operacion" readonly="1"/>
                                        <field name="resultado" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="texto" widget="text" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Payload enviado a WIS" invisible="not payload_enviado">
                                    <field name="payload_enviado" widget="text" readonly="1" nolabel="1"/>
                                </group>
                                <group string="Respuesta de WIS" invisible="not response_data">
                                    <field name="response_data" widget="text" readonly="1" nolabel="1"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>


              
            </field>
        </record>
    </data>
</odoo>