<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <data>
        

        <record id="view_picking_type_form_inherit_wms" model="ir.ui.view">
            <field name="name">stock.picking.type.form.inherit.wms</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <!-- Opción 1: Agregar después del notebook -->
                <xpath expr="//notebook" position="inside">
                    <page string="Integración WMS" name="wms_integration">
                        <group>
                            <field name="integracion_wms"/>
                            <!-- Aplica a operaciones internas (NO se gatea por integracion_wms):
                                 el picking adquiere el código del paso anterior. -->
                            <field name="adquiere_codigo_unico_wms"/>
                            <field name="tipo_pedido_wis" invisible="not integracion_wms"/>
                            <field name="tipo_expedicion_wis" invisible="not integracion_wms"/>
                            <field name="tipo_agente_wis" invisible="not integracion_wms"/>
                            <field name="metodo_creacion_wis" invisible="not integracion_wms"/>
                            <field name="estado_disparo_wis" invisible="not integracion_wms"/>
                            <field name="metodo_cancelacion_wis" invisible="not integracion_wms"/>
                            <field name="metodo_preparacion_wis" invisible="not integracion_wms"/>
                            <field name="integra_parciales" invisible="not integracion_wms"/>
                            <field name="conciliar_al_anular" invisible="not integracion_wms"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>    
    </data>
</odoo>