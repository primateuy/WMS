<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree de Conciliación de Maestros -->
    <record id="view_conciliacion_maestros_tree" model="ir.ui.view">
        <field name="name">conciliacion.maestros.tree</field>
        <field name="model">conciliacion.maestros</field>
        <field name="arch" type="xml">
            <tree string="Conciliación de Maestros" default_order="fecha_ejecucion desc">
                <field name="fecha_ejecucion"/>
                <field name="tipo_conciliacion"/>
                <field name="estado"/>
                <field name="productos_conciliados"/>
                <field name="clientes_conciliados"/>
                <field name="discrepancias_encontradas"/>
                <field name="tiempo_ejecucion"/>
                <field name="ejecutado_por"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form de Conciliación de Maestros -->
    <record id="view_conciliacion_maestros_form" model="ir.ui.view">
        <field name="name">conciliacion.maestros.form</field>
        <field name="model">conciliacion.maestros</field>
        <field name="arch" type="xml">
            <form string="Conciliación de Maestros">
                <header>
                    <button name="ejecutar_conciliacion" 
                            string="Ejecutar Conciliación" 
                            type="object" 
                            class="oe_highlight"
                            invisible="estado != 'borrador'"/>
                    <button name="forzar_ejecucion" 
                            string="Forzar Ejecución" 
                            type="object" 
                            class="oe_highlight"
                            groups="base.group_system"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,ejecutando,completado,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fecha_ejecucion"/>
                            <field name="tipo_conciliacion"/>
                            <field name="ejecutado_por"/>
                            <field name="proceso_automatico"/>
                        </group>
                        <group>
                            <field name="productos_conciliados"/>
                            <field name="clientes_conciliados"/>
                            <field name="discrepancias_encontradas"/>
                            <field name="tiempo_ejecucion"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Detalles de Ejecución">
                            <field name="detalles_ejecucion" readonly="1"/>
                        </page>
                        
                        <page string="Log de Errores" invisible="estado != 'error'">
                            <field name="log_errores" readonly="1"/>
                        </page>
                        
                        <page string="Discrepancias" invisible="discrepancias_encontradas == 0">
                            <field name="discrepancia_ids" readonly="1">
                                <tree>
                                    <field name="tipo_objeto"/>
                                    <field name="codigo_objeto"/>
                                    <field name="nombre_objeto"/>
                                    <field name="campo_discrepante"/>
                                    <field name="valor_odoo"/>
                                    <field name="valor_wms"/>
                                    <field name="estado"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Configuración" invisible="not proceso_automatico">
                            <field name="configuracion_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Search de Conciliación de Maestros -->
    <record id="view_conciliacion_maestros_search" model="ir.ui.view">
        <field name="name">conciliacion.maestros.search</field>
        <field name="model">conciliacion.maestros</field>
        <field name="arch" type="xml">
            <search string="Buscar Conciliaciones">
                <field name="fecha_ejecucion"/>
                <field name="tipo_conciliacion"/>
                <field name="estado"/>
                <field name="ejecutado_por"/>
                
                <filter string="Hoy" name="today" 
                        domain="[('fecha_ejecucion', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Esta Semana" name="this_week" 
                        domain="[('fecha_ejecucion', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este Mes" name="this_month" 
                        domain="[('fecha_ejecucion', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="En Progreso" name="executing" domain="[('estado', '=', 'ejecutando')]"/>
                <filter string="Completadas" name="completed" domain="[('estado', '=', 'completado')]"/>
                <filter string="Con Errores" name="error" domain="[('estado', '=', 'error')]"/>
                <filter string="Con Discrepancias" name="with_discrepancies" domain="[('discrepancias_encontradas', '>', 0)]"/>
                
                <separator/>
                <filter string="Proceso Automático" name="automatic" domain="[('proceso_automatico', '=', True)]"/>
                <filter string="Proceso Manual" name="manual" domain="[('proceso_automatico', '=', False)]"/>
                
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                    <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo_conciliacion'}"/>
                    <filter string="Ejecutado por" name="group_user" context="{'group_by': 'ejecutado_por'}"/>
                    <filter string="Fecha" name="group_fecha" context="{'group_by': 'fecha_ejecucion:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_conciliacion_maestros" model="ir.actions.act_window">
        <field name="name">Conciliación de Maestros</field>
        <field name="res_model">conciliacion.maestros</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Bienvenido al sistema de conciliación de maestros!
            </p>
            <p>
                Aquí puedes ver y gestionar todas las conciliaciones entre Odoo y el WMS.
                Las conciliaciones automáticas se ejecutan según la configuración establecida.
            </p>
        </field>
    </record>
</odoo>