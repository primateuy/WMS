<odoo>
    <data>
        <!-- Advertencia de variantes sin integrar con WIS.
             El objetivo es que el operador vea el problema en la Orden de Compra
             y no recién cuando la recepción falla en WIS. -->
        <record id="view_purchase_order_form_wis" model="ir.ui.view">
            <field name="name">purchase.order.form.wis</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="before">
                    <field name="wis_recepcion_integrada" invisible="1"/>
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not wis_recepcion_integrada or wis_cantidad_pendientes == 0 or state in ('purchase', 'done', 'cancel')">
                        <strong>
                            Esta orden tiene
                            <field name="wis_cantidad_pendientes" readonly="1" class="oe_inline"/>
                            variante(s) sin integrar con WIS.
                        </strong>
                        La recepción va a fallar en WIS si se confirma así.
                        <button name="action_wis_integrar_pendientes"
                                type="object"
                                string="Integrar ahora"
                                class="btn-primary btn-sm ms-2"/>
                    </div>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Integración WIS" name="wis_integration">
                        <group>
                            <field name="wis_cantidad_pendientes" readonly="1"/>
                        </group>
                        <field name="wis_variantes_pendientes_ids" nolabel="1" readonly="1"
                               invisible="wis_cantidad_pendientes == 0">
                            <tree create="false" delete="false" edit="false">
                                <field name="default_code" string="Referencia"/>
                                <field name="display_name" string="Variante"/>
                                <field name="barcode"/>
                                <field name="integracion_wms" string="Marcado para WMS"/>
                            </tree>
                        </field>
                        <div invisible="wis_cantidad_pendientes != 0" class="text-muted">
                            Todas las variantes de esta orden están integradas con WIS.
                        </div>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
