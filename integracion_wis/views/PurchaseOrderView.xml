<odoo>
    <data>
        <record id="view_purchase_order_form_custom_button" model="ir.ui.view">
            <field name="name">purchase.order.form.custom.button</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//notebook" position="inside">
                    <page string="Integración WIS" name="wis_integration">
                        <group>
                            <field name="numeroInterfazWMS" readonly="True"/>
                            <field name="referencia" readonly="True"/>
                        </group>
                        <button name="buttonWMS" 
                            string="Enviar a WIS" 
                            type="object" 
                            class="btn-primary" invisible="not numeroInterfazWMS or not referencia"/>
                    
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>