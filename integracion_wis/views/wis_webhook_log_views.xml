<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wis_webhook_log_tree" model="ir.ui.view">
        <field name="name">wis.webhook.log.tree</field>
        <field name="model">wis.webhook.log</field>
        <field name="arch" type="xml">
            <tree string="Webhook Logs" create="0" edit="0" delete="0" decoration-danger="estado == 'error'" decoration-success="estado == 'exito'" default_order="fecha desc, hora desc">
                <field name="fecha"/>
                <field name="hora"/>
                <field name="numero_interfaz_ejecucion" string="Nro. Interfaz"/>
                <field name="codigo_unico" string="Código WMS" optional="show"/>
                <field name="tipo"/>
                <field name="estado" widget="badge" decoration-danger="estado == 'error'" decoration-success="estado == 'exito'"/>
            </tree>
        </field>
    </record>

    <record id="view_wis_webhook_log_form" model="ir.ui.view">
        <field name="name">wis.webhook.log.form</field>
        <field name="model">wis.webhook.log</field>
        <field name="arch" type="xml">
            <form string="Webhook Log" create="0" edit="0" delete="0">
                <header>
                    <button name="action_reprocesar" type="object" string="Reprocesar"
                            class="btn-primary" invisible="estado != 'error'"
                            groups="stock.group_stock_manager"
                            confirm="Se vuelve a procesar en Odoo lo que mandó WIS, sin pedirle que lo reenvíe. Lo que ya se había aplicado no se repite. ¿Continuar?"/>
                    <button name="action_reprocesar" type="object" string="Reprocesar"
                            invisible="estado == 'error' or tipo in ('test', 'consultaStock', 'ENTRADA_DEBUG', 'desconocido')"
                            groups="stock.group_stock_manager"
                            confirm="Este webhook terminó bien. Se vuelve a procesar y sólo entra lo que no había entrado. ¿Continuar?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fecha" readonly="1"/>
                            <field name="hora" readonly="1"/>
                            <field name="numero_interfaz_ejecucion" readonly="1"/>
                            <field name="codigo_unico" string="Código WMS" readonly="1"/>
                            <field name="tipo" readonly="1"/>
                        </group>
                        <group>
                            <field name="estado" readonly="1" widget="badge" decoration-danger="estado == 'error'" decoration-success="estado == 'exito'"/>
                            <field name="notificacion_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request">
                            <field name="request" widget="code" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Respuesta">
                            <field name="respuesta" widget="code" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wis_webhook_log" model="ir.actions.act_window">
        <field name="name">Webhook Logs</field>
        <field name="res_model">wis.webhook.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_webhook_logs"
              name="Webhook Logs"
              parent="menu_integracion_wis_root"
              action="action_wis_webhook_log"
              sequence="60"/>
</odoo>
