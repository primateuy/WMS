<odoo>
    <data>
        <!-- Vista para product.template -->
        <record id="view_product_template_form_inherit_wis" model="ir.ui.view">
            <field name="name">product.template.form.inherit.wis</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Integración WIS" name="wis_integration">
                        <group name="wis_template_group">
                            <field name="integracion_wms" readonly="not active or type != 'product'"/>
                            <field name="wis_variantes_en_cola" readonly="1"
                                   invisible="not integracion_wms or wis_variantes_en_cola == 0"/>
                        </group>
                        <div class="alert alert-info" role="alert"
                             invisible="not integracion_wms or wis_variantes_en_cola == 0">
                            Las variantes se integran <b>en segundo plano</b>: podés seguir
                            trabajando. El avance se ve en Integración WIS → Cola de productos.
                            Si necesitás que salgan ahora, usá «Integrar ahora con WIS».
                        </div>
                        <group>
                            <button name="consultaStock" 
                                    type="object" 
                                    class="btn-primary" 
                                    string="Consultar Stock"
                                    invisible="not integracion_wms"/>
                            <button name="enviar_variantes_wms"
                                    type="object"
                                    class="btn-secondary"
                                    string="Integrar ahora con WIS"
                                    confirm="Se van a enviar todas las variantes a WIS en este momento. Con muchas variantes la pantalla puede quedar esperando la respuesta. ¿Continuar?"
                                    invisible="not integracion_wms"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Vista para product.product - Extiende la pestaña del template -->
        <record id="view_product_product_form_inherit_wis" model="ir.ui.view">
            <field name="name">product.product.form.inherit.wis</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <!-- Campos y botones dentro de la pestaña Integración WIS -->
                <xpath expr="//page[@name='wis_integration']" position="inside">
                    <separator string="Configuración específica de variante"/>
                    <group name="wis_product_group">
                        <group>
                            <field name="codigo_interfaz_wms" readonly="True"/>
                            <field name="codigo_unico" readonly="True"/>
                            <field name="ajusteStockManual"/>
                        </group>
                        <group groups="base.group_no_one">
                            <field name="wms_last_sync" readonly="1"/>
                            <field name="wms_sync_status" readonly="1"/>
                        </group>
                    </group>
                    <button name="enviarWS"
                            type="object"
                            string="Enviar a WMS"
                            class="btn-primary"
                            invisible="not integracion_wms or codigo_unico"/>
                    <button name="enviarWS"
                            type="object"
                            string="Sincronizar desde WIS"
                            class="btn-primary"
                            invisible="not integracion_wms or not codigo_unico"/>
                    <button name="saveBarcode"
                            type="object"
                            string="Sincronizar Código de Barras"
                            class="btn-secondary"
                            invisible="not integracion_wms or not barcode"/>
                </xpath>

                <!-- Pestaña Logs WIS al mismo nivel que Integración WIS -->
                <xpath expr="//notebook" position="inside">
                    <page string="Logs WIS" name="wms_logs_page" invisible="not integracion_wms">
                        <field name="wms_log_ids" readonly="1">
                            <tree decoration-success="resultado == 'success'"
                                  decoration-danger="resultado == 'error'"
                                  decoration-warning="resultado == 'warning'"
                                  decoration-info="resultado == 'info'"
                                  create="0" delete="0" edit="0">
                                <field name="fecha"/>
                                <field name="operacion"/>
                                <field name="resultado"/>
                                <field name="detalle"/>
                                <field name="payload_enviado" string="Enviado a WIS" optional="show"/>
                                <field name="usuario_id"/>
                            </tree>
                            <form create="0" delete="0" edit="0">
                                <group>
                                    <group>
                                        <field name="fecha" readonly="1"/>
                                        <field name="operacion" readonly="1"/>
                                        <field name="resultado" readonly="1"/>
                                        <field name="usuario_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="detalle" widget="text" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Payload enviado a WIS" invisible="not payload_enviado">
                                    <field name="payload_enviado" widget="text" readonly="1" nolabel="1"/>
                                </group>
                                <group string="Respuesta de WIS" invisible="not response_data">
                                    <field name="response_data" widget="text" readonly="1" nolabel="1"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>