<odoo>
  <data>

    <record id="view_wis_integrar_variantes_wizard_form" model="ir.ui.view">
      <field name="name">wis.integrar.variantes.wizard.form</field>
      <field name="model">wis.integrar.variantes.wizard</field>
      <field name="arch" type="xml">
        <form string="Variantes sin integrar en WIS">
          <div class="alert alert-warning" role="alert">
            <strong>Hay variantes de esta orden que todavía no están integradas con WIS.</strong>
            <p class="mb-0">
              Si la orden avanza así, la recepción va a fallar en WIS.
              <b>Integrar ahora</b> resuelve únicamente las variantes que esta orden
              necesita y continúa con la confirmación; el resto de las variantes de
              los mismos productos se integran en segundo plano, sin bloquearte.
            </p>
          </div>

          <group>
            <group>
              <field name="order_id" readonly="1"/>
              <field name="cantidad_variantes" string="Variantes que necesita la orden"/>
            </group>
            <group>
              <field name="cantidad_resto" string="Otras variantes (a segundo plano)"/>
            </group>
          </group>

          <field name="variante_ids" nolabel="1" readonly="1">
            <tree create="false" delete="false" edit="false">
              <field name="default_code" string="Referencia"/>
              <field name="display_name" string="Variante"/>
              <field name="barcode"/>
              <field name="integracion_wms" string="Marcado para WMS"/>
            </tree>
          </field>

          <footer>
            <button name="action_integrar_ahora" type="object"
                    string="Integrar ahora y confirmar" class="btn-primary"/>
            <button name="action_encolar_y_cerrar" type="object"
                    string="Encolar y revisar después" class="btn-secondary"/>
            <button name="action_continuar_sin_integrar" type="object"
                    string="Confirmar igual" class="btn-secondary"
                    confirm="La recepción en WIS puede fallar. ¿Confirmar la orden de todos modos?"/>
            <button string="Cancelar" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>
